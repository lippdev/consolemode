<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConsoleMode.Views.ConsoleHomeView"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ConsoleMode.ViewModels"
    xmlns:controls="using:ConsoleMode.Controls"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    XYFocusKeyboardNavigation="Enabled"
    RequestedTheme="Dark"
    FontFamily="{StaticResource ConsoleFontFamily}">
    <UserControl.Resources>
        <!-- Buttons and other controls take their font from this key, not from the parent. -->
        <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="ConsoleFontFamily"/>
    </UserControl.Resources>

    <!-- 10-foot layout: big cards, thick focus ring, no mouse needed. Solid background instead of Mica. -->
    <Grid x:Name="Root" Background="#07090D" Padding="56,0,56,32">
        <Grid.Resources>
            <!-- Containers of cards are not focus stops: the focus lands on the cards themselves. -->
            <Style TargetType="ItemsControl">
                <Setter Property="IsTabStop" Value="False"/>
            </Style>
            <Style x:Key="ConsoleHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Margin" Value="4,0,0,12"/>
            </Style>
            <Style x:Key="HintBadge" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <!-- Background: covers of your installed Steam games (or your picture) under a solid-colour gradient -->
        <Grid x:Name="BackgroundLayer" IsHitTestVisible="False" Margin="-56,0,-56,-32">
            <Grid Visibility="{x:Bind ViewModel.ShowBackgroundCovers, Mode=OneWay}" Opacity="0.55">
                <ItemsControl ItemsSource="{x:Bind ViewModel.BackgroundCovers, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="240" ItemHeight="360"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="media:ImageSource">
                            <Image Source="{x:Bind}" Stretch="UniformToFill" Width="228" Height="342" Margin="6"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Image Source="{x:Bind ViewModel.BackgroundCustomImage, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.7"
                   Visibility="{x:Bind ViewModel.ShowBackgroundCustom, Mode=OneWay}"/>
            <!-- Like a console home: the art shows on the right and fades to black on the left (where the text is)
                 and at the bottom, so the text stays readable over any picture -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F507090D" Offset="0"/>
                        <GradientStop Color="#C707090D" Offset="0.4"/>
                        <GradientStop Color="#4D07090D" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#F207090D" Offset="0"/>
                        <GradientStop Color="#0007090D" Offset="0.55"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ───────────── Idle (console-style: tabs on top, one page below) ───────────── -->
        <Grid Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}" RowSpacing="14" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar: the tabs on the left like a console's (LB / RB switch them), the status and clock on the right -->
            <Grid Grid.Row="0" Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" Background="{ThemeResource AccentFillColorDefaultBrush}"
                            AutomationProperties.Name="{x:Bind ViewModel.Texts.Brand, Mode=OneWay}">
                        <FontIcon Glyph="&#xE7FC;" FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintLb, Mode=OneWay}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/></Border>
                    <Button Style="{StaticResource ConsoleTab}" Command="{x:Bind ViewModel.SelectConsoleTabCommand}" CommandParameter="0"
                            Opacity="{x:Bind ViewModel.TabOpacity(ViewModel.ConsoleTabIndex, 0), Mode=OneWay}">
                        <Grid><TextBlock Text="{x:Bind ViewModel.Texts.TabHome, Mode=OneWay}"/>
                            <Border Style="{StaticResource TabUnderline}" Visibility="{x:Bind ViewModel.IsHomeTab, Mode=OneWay}"/></Grid>
                    </Button>
                    <Button Style="{StaticResource ConsoleTab}" Command="{x:Bind ViewModel.SelectConsoleTabCommand}" CommandParameter="1"
                            Opacity="{x:Bind ViewModel.TabOpacity(ViewModel.ConsoleTabIndex, 1), Mode=OneWay}">
                        <Grid><TextBlock Text="{x:Bind ViewModel.Texts.TabSession, Mode=OneWay}"/>
                            <Border Style="{StaticResource TabUnderline}" Visibility="{x:Bind ViewModel.IsSessionTab, Mode=OneWay}"/></Grid>
                    </Button>
                    <Button Style="{StaticResource ConsoleTab}" Command="{x:Bind ViewModel.SelectConsoleTabCommand}" CommandParameter="2"
                            Opacity="{x:Bind ViewModel.TabOpacity(ViewModel.ConsoleTabIndex, 2), Mode=OneWay}">
                        <Grid><TextBlock Text="{x:Bind ViewModel.Texts.TabSystem, Mode=OneWay}"/>
                            <Border Style="{StaticResource TabUnderline}" Visibility="{x:Bind ViewModel.IsSystemTab, Mode=OneWay}"/></Grid>
                    </Button>
                    <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintRb, Mode=OneWay}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/></Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ConsoleNavButton}" Command="{x:Bind ViewModel.SwitchUiCommand}" CommandParameter="desktop"
                            AutomationProperties.Name="{x:Bind ViewModel.Texts.SwitchToDesktop, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Texts.SwitchToDesktop, Mode=OneWay}">
                        <FontIcon Glyph="&#xE7F4;" FontSize="22"/>
                    </Button>
                    <FontIcon Glyph="&#xE7FC;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasControllerBattery, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.ControllerBatteryLabel, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.ControllerBatteryGlyph, Mode=OneWay}" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.ControllerBatteryText, Mode=OneWay}" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="ClockText" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Status banner -->
            <Border Grid.Row="1" Visibility="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}" CornerRadius="12" Padding="20,14"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="18" TextWrapping="Wrap"/>
            </Border>

            <!-- Update notice: HomeView's InfoBar isn't on this screen, so the console interface
                 needs its own way to actually install an update, not just find one (issue #49). -->
            <Border Grid.Row="1" Visibility="{x:Bind ViewModel.IsUpdateOpen, Mode=OneWay}" CornerRadius="14" Padding="24,20"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" Margin="0,0,0,4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.UpdateTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}" FontSize="15" TextWrapping="Wrap" MaxWidth="720"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <!-- Black focus ring: the default accent ring vanishes on this accent background. -->
                    <Button x:Name="UpdateNowButton" Grid.Column="1" Style="{StaticResource ConsoleSmallButton}" Height="48" Padding="20,0" FocusVisualPrimaryBrush="Black"
                            Command="{x:Bind ViewModel.ApplyUpdateCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsUpdating, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsUpdating, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind ViewModel.UpdateActionText, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ConsoleSmallButton}" Height="48" Padding="20,0" FocusVisualPrimaryBrush="Black"
                            Command="{x:Bind ViewModel.SkipUpdateCommand}" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Texts.IgnoreUpdate, Mode=OneWay}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Pages: one per tab -->
            <Grid Grid.Row="2">
                <!-- Home: the launchers in a row over the game art, then what will open and one button to play it -->
                <Grid x:Name="HomePanel" Visibility="{x:Bind ViewModel.IsHomeTab, Mode=OneWay}" RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ItemsControl x:Name="LaunchRow" ItemsSource="{x:Bind ViewModel.LaunchTiles, Mode=OneWay}" Margin="24,40,8,0" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="34"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LaunchTile">
                                <!-- The focus picks the launcher and A plays it. The one that opens grows (ConsoleHomeView.ScaleLaunchTiles),
                                     keeps its full colour and lights the background behind it; the others fade back. -->
                                <Grid Opacity="{x:Bind Opacity, Mode=OneWay}">
                                    <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.18"/></Grid.OpacityTransition>
                                    <Border Margin="-44" Background="{x:Bind Glow}" Opacity="{x:Bind GlowOpacity, Mode=OneWay}" IsHitTestVisible="False">
                                        <Border.OpacityTransition><ScalarTransition Duration="0:0:0.18"/></Border.OpacityTransition>
                                    </Border>
                                    <Button Style="{StaticResource LaunchTileButton}" Background="{x:Bind Background}"
                                            Command="{Binding ViewModel.PlayLaunchTileCommand, ElementName=Page}" CommandParameter="{x:Bind}"
                                            AutomationProperties.Name="{x:Bind Text}">
                                        <Grid>
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="48" Margin="0,0,0,20"/>
                                            <TextBlock Text="{x:Bind Text}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="#E6FFFFFF"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="10" Margin="4,0,0,48" MaxWidth="1000" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Bind ViewModel.SelectedLaunch.Text, Mode=OneWay}" FontSize="60" FontWeight="Bold" CharacterSpacing="-20"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <TextBlock Text="{x:Bind ViewModel.SummaryTitle, Mode=OneWay}" FontSize="24" Foreground="#E6FFFFFF"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="19" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1">
                            <Run Text="{x:Bind ViewModel.FocusRow.SelectedMode.Text, Mode=OneWay}"/><Run Text="{x:Bind ViewModel.HomeMetaText, Mode=OneWay}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,18,0,0">
                            <Button x:Name="PlayButton" Style="{StaticResource ConsolePlayButton}"
                                    Command="{x:Bind ViewModel.StartCommand}" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xE768;" FontSize="24"/>
                                    <TextBlock Text="{x:Bind ViewModel.StartButtonText, Mode=OneWay}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <!-- Screens, audio and quick settings live one tab over -->
                            <Button Style="{StaticResource ConsoleNavButton}" Width="64" Height="64" CornerRadius="32" Background="#26FFFFFF"
                                    Command="{x:Bind ViewModel.SelectConsoleTabCommand}" CommandParameter="1"
                                    AutomationProperties.Name="{x:Bind ViewModel.Texts.TabSession, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.Texts.TabSession, Mode=OneWay}">
                                <FontIcon Glyph="&#xE712;" FontSize="24"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Session: the screens and the quick settings -->
                <ScrollViewer x:Name="SessionPanel" Visibility="{x:Bind ViewModel.IsSessionTab, Mode=OneWay}" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="10">
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Texts.ConsoleScreensHeading, Mode=OneWay}" Style="{StaticResource ConsoleHeading}"/>
                            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                                <ItemsControl x:Name="ScreenCards" Margin="8,16,8,16" ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MonitorRowViewModel">
                                            <Button Style="{StaticResource ConsoleCard}" Width="300" Height="204" Padding="0"
                                                    Background="{x:Bind ConsoleTileBackground, Mode=OneWay}" Opacity="{x:Bind TileOpacity, Mode=OneWay}"
                                                    Command="{Binding ViewModel.OpenRolePanelCommand, ElementName=Page}" CommandParameter="{x:Bind}"
                                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                                <Grid Padding="22,18,22,16">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- The screen drawn as art: bezel, lit panel (by what will happen to it) and stand -->
                                                    <Grid Width="124" Height="90" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                        <Border Height="72" VerticalAlignment="Top" CornerRadius="9" BorderThickness="3" BorderBrush="#FFE6EBEF">
                                                            <Border Background="{x:Bind ScreenFill, Mode=OneWay}" CornerRadius="5">
                                                                <Grid>
                                                                    <FontIcon Glyph="&#xE768;" FontSize="24" Foreground="#FF0B1F18" Visibility="{x:Bind IsFocus, Mode=OneWay}"/>
                                                                    <FontIcon Glyph="&#xE7E8;" FontSize="22" Foreground="#99FFFFFF" Visibility="{x:Bind IsHide, Mode=OneWay}"/>
                                                                </Grid>
                                                            </Border>
                                                        </Border>
                                                        <Border Width="46" Height="6" CornerRadius="3" Background="#FFE6EBEF" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                    </Grid>
                                                    <StackPanel Grid.Row="1" Spacing="6">
                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border CornerRadius="11" Padding="11,3" Background="{x:Bind RolePillBackground, Mode=OneWay}">
                                                                <TextBlock Text="{x:Bind RoleLabel, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                                                           Foreground="{x:Bind RolePillForeground, Mode=OneWay}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Details, Mode=OneWay}" FontSize="14" VerticalAlignment="Center"
                                                                       Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Texts.ConsoleQuickHeading, Mode=OneWay}" Style="{StaticResource ConsoleHeading}"/>
                            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="8,16,8,16">
                                <Button Style="{StaticResource ConsoleCard}" Width="208" Height="208" Command="{x:Bind ViewModel.OpenPickerCommand}" CommandParameter="launch"
                                        AutomationProperties.Name="{x:Bind ViewModel.Texts.LaunchCard, Mode=OneWay}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="21" Background="#26FFFFFF" HorizontalAlignment="Left">
                                            <FontIcon Glyph="&#xE768;" FontSize="19"/>
                                        </Border>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.Texts.LaunchCard, Mode=OneWay}" FontSize="14" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{x:Bind ViewModel.SelectedLaunch.Text, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource ConsoleCard}" Width="208" Height="208" Command="{x:Bind ViewModel.OpenPickerCommand}" CommandParameter="audio"
                                        AutomationProperties.Name="{x:Bind ViewModel.Texts.AudioOutputCard, Mode=OneWay}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="21" Background="#26FFFFFF" HorizontalAlignment="Left">
                                            <FontIcon Glyph="&#xE767;" FontSize="19"/>
                                        </Border>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.Texts.AudioOutputCard, Mode=OneWay}" FontSize="14" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{x:Bind ViewModel.SelectedAudio.Text, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource ConsoleCard}" Width="208" Height="208" Command="{x:Bind ViewModel.OpenPickerCommand}" CommandParameter="mode"
                                        IsEnabled="{x:Bind ViewModel.HasFocusRow, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.Texts.ResolutionRefreshCard, Mode=OneWay}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="21" Background="#26FFFFFF" HorizontalAlignment="Left">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="19"/>
                                        </Border>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.Texts.ResolutionRefreshCard, Mode=OneWay}" FontSize="14" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{x:Bind ViewModel.FocusRow.SelectedMode.Text, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource ConsoleCard}" Width="208" Height="208" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="hdr"
                                        AutomationProperties.Name="{x:Bind ViewModel.Texts.HdrCard, Mode=OneWay}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="21" Background="#26FFFFFF" HorizontalAlignment="Left">
                                            <FontIcon Glyph="&#xE706;" FontSize="19"/>
                                        </Border>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.Texts.HdrCard, Mode=OneWay}" FontSize="14" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{x:Bind ViewModel.HdrText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource ConsoleCard}" Width="208" Height="208" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="vrr"
                                        AutomationProperties.Name="{x:Bind ViewModel.Texts.VrrCard, Mode=OneWay}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="21" Background="#26FFFFFF" HorizontalAlignment="Left">
                                            <FontIcon Glyph="&#xE895;" FontSize="19"/>
                                        </Border>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.Texts.VrrCard, Mode=OneWay}" FontSize="14" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{x:Bind ViewModel.VrrText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource ConsoleCard}" Width="208" Height="208" Command="{x:Bind ViewModel.OpenPickerCommand}" CommandParameter="fps"
                                        IsEnabled="{x:Bind ViewModel.IsFpsAvailable, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.Texts.FpsCard, Mode=OneWay}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="21" Background="#26FFFFFF" HorizontalAlignment="Left">
                                            <FontIcon Glyph="&#xE916;" FontSize="19"/>
                                        </Border>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.Texts.FpsCard, Mode=OneWay}" FontSize="14" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{x:Bind ViewModel.SelectedFps.Text, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                        </StackPanel>
                </ScrollViewer>

                <!-- System tab: every setting, as rows -->
                <Grid x:Name="SettingsPanel" Visibility="{x:Bind ViewModel.IsConsoleSettingsOpen, Mode=OneWay}">
                    <Grid.Resources>
                        <!-- Row content: label + value -->
                        <Style x:Key="RowLabel" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="MaxLines" Value="2"/>
                        </Style>
                        <Style x:Key="RowValue" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="MaxLines" Value="2"/>
                            <Setter Property="MaxWidth" Value="420"/>
                        </Style>
                    </Grid.Resources>
                    <!-- Categories on the left (moving over one shows its options), only that category's options on the right -->
                    <Grid ColumnSpacing="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="CategoryRail" Spacing="4" Padding="14,4,0,0">
                            <Button Style="{StaticResource ConsoleCategory}" Tag="0" Click="OnCategoryClick" GotFocus="OnCategoryFocused">
                                <Grid>
                                    <Border Width="4" Height="28" CornerRadius="2" HorizontalAlignment="Left" Margin="-14,0,0,0" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind ViewModel.CategoryVisibility(ViewModel.SystemCategory, 0), Mode=OneWay}"/>

                                                        <TextBlock Style="{StaticResource RowLabel}" Text="ControlFS"/>
                                                        <Border CornerRadius="10" Padding="9,2" VerticalAlignment="Center" Background="#2633D69F">
                                                            <TextBlock Text="{x:Bind ViewModel.Texts.OtherAppsStageAlpha, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind ViewModel.Texts.OtherAppsControlFsDescription, Mode=OneWay}" FontSize="16" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource ConsoleCard}" Padding="0" Height="320" HorizontalAlignment="Stretch" VerticalContentAlignment="Top"
                                                Command="{x:Bind ViewModel.OpenLinkCommand}" CommandParameter="https://github.com/lippdev/tako-launcher">
                                            <Grid><Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <Border CornerRadius="18,18,0,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FF3A3150" Offset="0"/>
                                                            <GradientStop Color="#FF0D0B13" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Image Source="{x:Bind ViewModel.TakoLogo}" Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Row="1" Spacing="8" Padding="22,18,22,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Style="{StaticResource RowLabel}" Text="Tako Launcher"/>
                                                        <Border CornerRadius="10" Padding="9,2" VerticalAlignment="Center" Background="#2633D69F">
                                                            <TextBlock Text="{x:Bind ViewModel.Texts.OtherAppsStageClosedAlpha, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind ViewModel.Texts.OtherAppsTakoDescription, Mode=OneWay}" FontSize="16" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource ConsoleCard}" Padding="0" Height="320" HorizontalAlignment="Stretch" VerticalContentAlignment="Top"
                                                Command="{x:Bind ViewModel.OpenLinkCommand}" CommandParameter="https://github.com/lippdev/joychromium">
                                            <Grid><Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <Border CornerRadius="18,18,0,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FF1F5BD8" Offset="0"/>
                                                            <GradientStop Color="#FF0A1530" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Image Source="{x:Bind ViewModel.JoyChromiumBrandLogo}" Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Row="1" Spacing="8" Padding="22,18,22,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Style="{StaticResource RowLabel}" Text="JoyChromium"/>
                                                        <Border CornerRadius="10" Padding="9,2" VerticalAlignment="Center" Background="#2633D69F">
                                                            <TextBlock Text="{x:Bind ViewModel.Texts.OtherAppsStageBeta, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind ViewModel.Texts.OtherAppsJoyChromiumDescription, Mode=OneWay}" FontSize="16" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                            <!-- The list fades into the background at an edge with more rows past it, instead of being cut
                                 (shown from code, ConsoleHomeView.UpdateRowsScroll) -->
                            <Rectangle x:Name="RowsFadeTop" Height="64" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0"
                                       OpacityTransition="{StaticResource ConsoleFade}">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F507090D" Offset="0"/>
                                        <GradientStop Color="#0007090D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle x:Name="RowsFadeBottom" Height="150" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0"
                                       OpacityTransition="{StaticResource ConsoleFade}">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#F507090D" Offset="0"/>
                                        <GradientStop Color="#0007090D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- Where the list is: a thin track with its thumb, right of the rows, only when it scrolls -->
                            <Grid x:Name="RowsScrollTrack" Width="5" HorizontalAlignment="Right" Margin="0,6,-22,6" IsHitTestVisible="False"
                                  Opacity="0" OpacityTransition="{StaticResource ConsoleFade}">
                                <Border CornerRadius="3" Background="#1FFFFFFF"/>
                                <Border x:Name="RowsScrollThumb" CornerRadius="3" Background="#A6FFFFFF" VerticalAlignment="Top" Height="40"/>
                            </Grid>
                            <TextBlock x:Name="RowHelp" Grid.Row="1" FontSize="18" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="12,0,12,4"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- The controller hints; LB / RB already sit by the tabs at the top -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="22" HorizontalAlignment="Right" Opacity="0.8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintConfirm, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.HintSelect, Mode=OneWay}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintMenu, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.StartNow, Mode=OneWay}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintAlt, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Settings, Mode=OneWay}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
            </StackPanel>
        </Grid>


        <!-- ───────────── Role panel (overlay) ───────────── -->
        <Grid x:Name="RolePanel" Visibility="{x:Bind ViewModel.IsRolePanelOpen, Mode=OneWay}" Background="#CC07090D">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" MaxWidth="900">
                <TextBlock Text="{x:Bind ViewModel.RolePanelTitle, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <Button x:Name="RolePlay" Style="{StaticResource ConsoleCard}" Width="240" Height="150"
                            Command="{x:Bind ViewModel.SetRoleCommand}" CommandParameter="0">
                        <StackPanel Spacing="12"><FontIcon Glyph="&#xE7FC;" FontSize="34"/><TextBlock Text="{x:Bind ViewModel.Texts.RolePlayHere, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ConsoleCard}" Width="240" Height="150"
                            Command="{x:Bind ViewModel.SetRoleCommand}" CommandParameter="1">
                        <StackPanel Spacing="12"><FontIcon Glyph="&#xE7E8;" FontSize="34"/><TextBlock Text="{x:Bind ViewModel.Texts.RoleTurnOff, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ConsoleCard}" Width="240" Height="150"
                            Command="{x:Bind ViewModel.SetRoleCommand}" CommandParameter="2">
                        <StackPanel Spacing="12"><FontIcon Glyph="&#xE7F4;" FontSize="34"/><TextBlock Text="{x:Bind ViewModel.Texts.RoleKeepOn, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource ConsoleSmallButton}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.CloseRolePanelCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ───────────── Option picker (modal) ───────────── -->
        <Grid x:Name="PickerPanel" Visibility="{x:Bind ViewModel.IsPickerOpen, Mode=OneWay}" Background="#E607090D">
            <Grid MaxWidth="820" VerticalAlignment="Center" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.PickerTitle, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="PickerList" ItemsSource="{x:Bind ViewModel.PickerOptions, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PickerItem">
                                <Button Style="{StaticResource ConsoleRow}" Width="760"
                                        Command="{Binding ViewModel.PickOptionCommand, ElementName=Page}" CommandParameter="{x:Bind}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="24">
                                            <FontIcon Glyph="&#xE73E;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      Visibility="{x:Bind IsSelected}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="2" Style="{StaticResource ConsoleSmallButton}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ClosePickerCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ───────────── First-run tour (overlay) ─────────────
             A veil over the whole window with a hole around the part of the screen the stop is about (drawn in
             ConsoleHomeView.PlaceTour), a ring around the hole and a card with the texts beside it. -->
        <Grid x:Name="ConsoleTourPanel" Visibility="{x:Bind ViewModel.IsConsoleTourOpen, Mode=OneWay}" Margin="-56,-48,-56,-32"
              TabFocusNavigation="Cycle" SizeChanged="OnTourPanelSizeChanged">
            <Path x:Name="TourVeil" Fill="#D907090D"/>
            <Border x:Name="TourRing" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="3" CornerRadius="20"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False"/>
            <Border x:Name="TourCard" HorizontalAlignment="Left" VerticalAlignment="Top" Width="600" CornerRadius="22" Padding="36,30"
                    Background="#F2121826" BorderBrush="#33FFFFFF" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind ViewModel.ConsoleTourProgress, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.ConsoleTourTitle, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.ConsoleTourBody, Mode=OneWay}" FontSize="20" TextWrapping="Wrap" LineHeight="30"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                        <Button x:Name="ConsoleTourNextButton" Style="{StaticResource ConsolePlayButton}" Padding="30,12" MinWidth="180" Height="52"
                                Command="{x:Bind ViewModel.ConsoleTourNextCommand}">
                            <TextBlock Text="{x:Bind ViewModel.ConsoleTourNextText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource ConsoleSmallButton}" Height="52" Padding="22,0" Command="{x:Bind ViewModel.ConsoleTourBackCommand}"
                                Visibility="{x:Bind ViewModel.CanGoBackInConsoleTour, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}" FontSize="18"/>
                        </Button>
                        <Button Style="{StaticResource ConsoleSmallButton}" Height="52" Padding="22,0" Command="{x:Bind ViewModel.EndTourCommand}"
                                Visibility="{x:Bind ViewModel.ShowSkipConsoleTour, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.Texts.SkipTour, Mode=OneWay}" FontSize="18"/>
                        </Button>
                    </StackPanel>
                    <!-- A next, B skips; the arrows move between the buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="18" Opacity="0.7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintConfirm, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="{x:Bind ViewModel.ConsoleTourNextText, Mode=OneWay}" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.ShowSkipConsoleTour, Mode=OneWay}">
                            <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="{x:Bind ViewModel.Texts.SkipTour, Mode=OneWay}" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- The stop's time running out: the tour moves on by itself when it fills (ConsoleTour.DwellTime) -->
                    <Grid Height="4" CornerRadius="2" Background="#26FFFFFF" Margin="0,4,0,0">
                        <Border x:Name="TourTimeBar" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ShortcutEditorPanel" Visibility="{x:Bind ViewModel.IsShortcutEditorOpen, Mode=OneWay}" Background="#E607090D" TabFocusNavigation="Cycle">
            <Grid MaxWidth="1320" VerticalAlignment="Center" RowSpacing="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.ShortcutEditorTitle, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <ScrollViewer Grid.Row="1" IsTabStop="False" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="16" Margin="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#FF20292E" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="12"><TextBlock Text="{x:Bind ViewModel.Texts.HomeButtonCard, Mode=OneWay}" FontSize="19" MinHeight="52" FontWeight="SemiBold" TextWrapping="Wrap"/><ContentControl x:Name="HomeShortcutPickerHost" IsTabStop="False" HorizontalContentAlignment="Stretch"/></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#FF20292E" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="12"><TextBlock Text="{x:Bind ViewModel.Texts.SessionMenuCard, Mode=OneWay}" FontSize="19" MinHeight="52" FontWeight="SemiBold" TextWrapping="Wrap"/><ContentControl x:Name="MenuShortcutPickerHost" IsTabStop="False" HorizontalContentAlignment="Stretch"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FF20292E" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="12"><TextBlock Text="{x:Bind ViewModel.Texts.ExitShortcutCard, Mode=OneWay}" FontSize="19" MinHeight="52" FontWeight="SemiBold" TextWrapping="Wrap"/><ContentControl x:Name="ExitShortcutPickerHost" IsTabStop="False" HorizontalContentAlignment="Stretch"/></StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#FF20292E" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="12"><TextBlock Text="{x:Bind ViewModel.Texts.TaskViewShortcutCard, Mode=OneWay}" FontSize="19" MinHeight="52" FontWeight="SemiBold" TextWrapping="Wrap"/><ContentControl x:Name="TaskViewShortcutPickerHost" IsTabStop="False" HorizontalContentAlignment="Stretch"/></StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <Button Grid.Row="2" Style="{StaticResource ConsoleSmallButton}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.CloseShortcutEditorCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10"><Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border><TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}"/></StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ───────────── Controller test (overlay) ───────────── -->
        <Grid x:Name="ControllerTestPanel" Visibility="{x:Bind ViewModel.IsControllerTestOpen, Mode=OneWay}" Background="#07090D" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Texts.ControllerTestCard, Mode=OneWay}" FontSize="36" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.Texts.ControllerTestSteamHint, Mode=OneWay}" FontSize="17" TextWrapping="Wrap" MaxWidth="1100" HorizontalAlignment="Left"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Texts.ControllerDevicesHeading, Mode=OneWay}" Style="{StaticResource ConsoleHeading}" Margin="4,8,0,4"/>
                <TextBlock Text="{x:Bind ViewModel.ControllerDevicesText, Mode=OneWay}" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Texts.ControllerSampleHeading, Mode=OneWay}" Style="{StaticResource ConsoleHeading}" Margin="4,8,0,4"/>
                <TextBlock Text="{x:Bind ViewModel.ControllerSampleText, Mode=OneWay}" FontFamily="Consolas" FontSize="18" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16">
                <Button x:Name="CopyDiagnosticsButton" Style="{StaticResource ConsoleSmallButton}" Height="56" Padding="24,0" Command="{x:Bind ViewModel.CopyControllerDiagnosticsCommand}">
                    <TextBlock Text="{x:Bind ViewModel.Texts.CopyDiagnostics, Mode=OneWay}"/>
                </Button>
                <Button Style="{StaticResource ConsoleSmallButton}" Height="56" Padding="24,0" Command="{x:Bind ViewModel.CloseControllerTestCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ───────────── Active session ───────────── -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" MaxWidth="720"
                    Visibility="{x:Bind ViewModel.IsConsoleActive, Mode=OneWay}">
            <Border Width="120" Height="120" CornerRadius="60" HorizontalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE7FC;" FontSize="52" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.Texts.ActiveTitle, Mode=OneWay}" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.ActiveDescText, Mode=OneWay}" FontSize="20" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button x:Name="RestoreButton" Style="{StaticResource ConsolePlayButton}" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Command="{x:Bind ViewModel.RestoreNowCommand}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <FontIcon Glyph="&#xE7A7;" FontSize="24"/>
                    <TextBlock Text="{x:Bind ViewModel.Texts.BackToPc, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" Width="220" Visibility="{x:Bind ViewModel.IsRestoring, Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.ConsoleActiveHintText, Mode=OneWay}" FontSize="17" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        <!-- ───────────── Opening (over everything while the app loads) ─────────────
             "Aproximação": the logo comes from close to the camera, big and blurred, and settles sharp in the middle, then
             the name; shown and faded out from code (ConsoleHomeView.ShowIntro / HideIntro), skipped by any press, click or key. -->
        <Grid x:Name="IntroPanel" Visibility="Collapsed" Margin="-56,-48,-56,-32" Background="#07090D" Tapped="OnIntroTapped">
            <!-- Console Mode's own, "Liga o PC": the logo drawn as vectors (viewBox 256, like assets/icon.ico) so each part can
                 come on by itself: the power light, the base, the screen drawing itself, a green flash, the >_ typed, the name.
                 Opacities that start at 0 are set from code (ConsoleHomeView.ShowConsoleIntro). -->
            <Grid x:Name="IntroConsole">
                <Ellipse x:Name="IntroGlow" Width="900" Height="900" Opacity="0.55" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#552FD3A0" Offset="0"/>
                            <GradientStop Color="#1A2F6FD3" Offset="0.45"/>
                            <GradientStop Color="#0007090D" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
                    <Viewbox Width="132" Height="132" HorizontalAlignment="Center">
                        <Canvas Width="256" Height="256">
                            <Rectangle x:Name="LogoScreenFill" Canvas.Left="22" Canvas.Top="14" Width="212" Height="156" RadiusX="30" RadiusY="30" Fill="#33D69F"/>
                            <!-- Dash lengths are in stroke widths: one dash as long as the whole line, so the offset draws it -->
                            <Rectangle x:Name="LogoScreen" Canvas.Left="22" Canvas.Top="14" Width="212" Height="156" RadiusX="30" RadiusY="30"
                                       Stroke="#24292E" StrokeThickness="18" StrokeDashArray="40 40"/>
                            <Path x:Name="LogoChevron" Data="M64,62 L104,88 L64,114" Stroke="#33D69F" StrokeThickness="14" StrokeDashArray="7.2 7.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" StrokeLineJoin="Round"/>
                            <!-- The box shows the cursor when it's typed; the cursor itself blinks -->
                            <Canvas x:Name="LogoCursorBox">
                                <Path x:Name="LogoCursor" Data="M118,124 L168,124" Stroke="#33D69F" StrokeThickness="14" StrokeDashArray="3.8 3.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round"/>
                            </Canvas>
                            <Rectangle x:Name="LogoBase" Canvas.Left="8" Canvas.Top="182" Width="240" Height="64" RadiusX="16" RadiusY="16" Fill="#24292E"/>
                            <Path x:Name="LogoDash" Data="M30,214 L50,214" Stroke="#33D69F" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse x:Name="LogoPowerGlow" Canvas.Left="176" Canvas.Top="161" Width="80" Height="80">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#B333D69F" Offset="0"/>
                                        <GradientStop Color="#0033D69F" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Canvas x:Name="LogoPower">
                                <Path Data="M206,200 A18,18 0 1 0 226,200" Stroke="#33D69F" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M216,190 L216,212" Stroke="#33D69F" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="IntroName" Text="Console Mode" FontSize="46" FontWeight="SemiBold" CharacterSpacing="-10"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- In the mood of the Xbox 360's: green and silver ribbons orbiting into an orb on a light background, a flash,
                 the logo. Each ribbon is a dashed circle that turns inside a flattened frame (so its arcs orbit in
                 perspective), inside a frame that shrinks to the orb. -->
            <Grid x:Name="IntroX360" Visibility="Collapsed">
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#FFE6EBE7" Offset="0.55"/>
                            <GradientStop Color="#FFB9C2BD" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Grid x:Name="X360Ribbons"/>
                <Ellipse x:Name="X360Orb" Width="240" Height="240">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#E6A0E65A" Offset="0.35"/>
                            <GradientStop Color="#005CBE28" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Opacities that start at 0 are set from code: the Composition fades don't move a XAML Opacity -->
                <Rectangle x:Name="X360Flash" Fill="White"/>
                <StackPanel x:Name="X360Mark" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
                    <Image Source="ms-appx:///Assets/Intro/logo.png" Width="132" Height="132"/>
                    <TextBlock Text="Console Mode" FontSize="46" FontWeight="SemiBold" CharacterSpacing="-10" Foreground="#FF1F2A24" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- In the mood of the PS4's: a deep blue with waves of light drifting across and particles rising, the logo
                 coming up in the light. -->
            <Grid x:Name="IntroPs4" Visibility="Collapsed">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF0A3A9E" Offset="0"/>
                            <GradientStop Color="#FF06205E" Offset="0.55"/>
                            <GradientStop Color="#FF020B26" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas x:Name="Ps4Waves" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Canvas x:Name="Ps4Particles"/>
                <Ellipse x:Name="Ps4Light" Width="1100" Height="1100">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#59A0C8FF" Offset="0"/>
                            <GradientStop Color="#00A0C8FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel x:Name="Ps4Mark" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
                    <Image Source="ms-appx:///Assets/Intro/logo.png" Width="132" Height="132"/>
                    <TextBlock Text="Console Mode" FontSize="46" FontWeight="SemiBold" CharacterSpacing="-10" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

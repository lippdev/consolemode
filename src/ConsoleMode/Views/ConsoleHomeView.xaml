                                    </Button>
                                    <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenLinkCommand}" CommandParameter="https://nextboost.pro">
                                        <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                            <Image Source="{x:Bind ViewModel.NextBoostLogo}" Width="36" Height="36"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="Next Boost"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.Texts.NextBoostDescription, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Normal"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- The controller hints; LB / RB already sit by the tabs at the top -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="22" HorizontalAlignment="Right" Opacity="0.8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintConfirm, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.HintSelect, Mode=OneWay}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintMenu, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.StartNow, Mode=OneWay}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintAlt, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Settings, Mode=OneWay}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
            </StackPanel>
        </Grid>


        <!-- ───────────── Role panel (overlay) ───────────── -->
        <Grid x:Name="RolePanel" Visibility="{x:Bind ViewModel.IsRolePanelOpen, Mode=OneWay}" Background="#CC07090D">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" MaxWidth="900">
                <TextBlock Text="{x:Bind ViewModel.RolePanelTitle, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <Button x:Name="RolePlay" Style="{StaticResource ConsoleCard}" Width="240" Height="150"
                            Command="{x:Bind ViewModel.SetRoleCommand}" CommandParameter="0">
                        <StackPanel Spacing="12"><FontIcon Glyph="&#xE7FC;" FontSize="34"/><TextBlock Text="{x:Bind ViewModel.Texts.RolePlayHere, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ConsoleCard}" Width="240" Height="150"
                            Command="{x:Bind ViewModel.SetRoleCommand}" CommandParameter="1">
                        <StackPanel Spacing="12"><FontIcon Glyph="&#xE7E8;" FontSize="34"/><TextBlock Text="{x:Bind ViewModel.Texts.RoleTurnOff, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ConsoleCard}" Width="240" Height="150"
                            Command="{x:Bind ViewModel.SetRoleCommand}" CommandParameter="2">
                        <StackPanel Spacing="12"><FontIcon Glyph="&#xE7F4;" FontSize="34"/><TextBlock Text="{x:Bind ViewModel.Texts.RoleKeepOn, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource ConsoleSmallButton}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.CloseRolePanelCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ───────────── Option picker (modal) ───────────── -->
        <Grid x:Name="PickerPanel" Visibility="{x:Bind ViewModel.IsPickerOpen, Mode=OneWay}" Background="#E607090D">
            <Grid MaxWidth="820" VerticalAlignment="Center" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.PickerTitle, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="PickerList" ItemsSource="{x:Bind ViewModel.PickerOptions, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PickerItem">
                                <Button Style="{StaticResource ConsoleRow}" Width="760"
                                        Command="{Binding ViewModel.PickOptionCommand, ElementName=Page}" CommandParameter="{x:Bind}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="24">
                                            <FontIcon Glyph="&#xE73E;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      Visibility="{x:Bind IsSelected}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="2" Style="{StaticResource ConsoleSmallButton}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ClosePickerCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid x:Name="ConsoleTutorialPanel" Visibility="{x:Bind ViewModel.IsConsoleTutorialOpen, Mode=OneWay}" Background="#F207090D" TabFocusNavigation="Cycle">
            <StackPanel MaxWidth="850" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <TextBlock Text="{x:Bind ViewModel.ConsoleTutorialTitle, Mode=OneWay}" FontSize="34" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.ConsoleTutorialBody, Mode=OneWay}" FontSize="22" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
                    <Button x:Name="ConsoleTutorialNextButton" Style="{StaticResource ConsolePlayButton}" Padding="30,12" Command="{x:Bind ViewModel.TourNextCommand}">
                        <TextBlock Text="{x:Bind ViewModel.ConsoleTutorialAction, Mode=OneWay}" FontSize="21" FontWeight="SemiBold"/>
                    </Button>
                    <Button Style="{StaticResource ConsoleSmallButton}" Padding="24,12" Command="{x:Bind ViewModel.EndTourCommand}">
                        <TextBlock Text="{x:Bind ViewModel.Texts.SkipTour, Mode=OneWay}" FontSize="18"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid x:Name="ShortcutEditorPanel" Visibility="{x:Bind ViewModel.IsShortcutEditorOpen, Mode=OneWay}" Background="#E607090D" TabFocusNavigation="Cycle">
            <Grid MaxWidth="1000" VerticalAlignment="Center" RowSpacing="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.ShortcutEditorTitle, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <ScrollViewer Grid.Row="1" IsTabStop="False" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="16" Margin="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#FF20292E" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="12"><TextBlock Text="{x:Bind ViewModel.Texts.HomeButtonCard, Mode=OneWay}" FontSize="19" MinHeight="52" FontWeight="SemiBold" TextWrapping="Wrap"/><ContentControl x:Name="HomeShortcutPickerHost" IsTabStop="False" HorizontalContentAlignment="Stretch"/></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#FF20292E" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="12"><TextBlock Text="{x:Bind ViewModel.Texts.SessionMenuCard, Mode=OneWay}" FontSize="19" MinHeight="52" FontWeight="SemiBold" TextWrapping="Wrap"/><ContentControl x:Name="MenuShortcutPickerHost" IsTabStop="False" HorizontalContentAlignment="Stretch"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FF20292E" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="12"><TextBlock Text="{x:Bind ViewModel.Texts.ExitShortcutCard, Mode=OneWay}" FontSize="19" MinHeight="52" FontWeight="SemiBold" TextWrapping="Wrap"/><ContentControl x:Name="ExitShortcutPickerHost" IsTabStop="False" HorizontalContentAlignment="Stretch"/></StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <Button Grid.Row="2" Style="{StaticResource ConsoleSmallButton}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.CloseShortcutEditorCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10"><Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border><TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}"/></StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ───────────── Controller test (overlay) ───────────── -->
        <Grid x:Name="ControllerTestPanel" Visibility="{x:Bind ViewModel.IsControllerTestOpen, Mode=OneWay}" Background="#07090D" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Texts.ControllerTestCard, Mode=OneWay}" FontSize="36" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.Texts.ControllerTestSteamHint, Mode=OneWay}" FontSize="17" TextWrapping="Wrap" MaxWidth="1100" HorizontalAlignment="Left"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Texts.ControllerDevicesHeading, Mode=OneWay}" Style="{StaticResource ConsoleHeading}" Margin="4,8,0,4"/>
                <TextBlock Text="{x:Bind ViewModel.ControllerDevicesText, Mode=OneWay}" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Texts.ControllerSampleHeading, Mode=OneWay}" Style="{StaticResource ConsoleHeading}" Margin="4,8,0,4"/>
                <TextBlock Text="{x:Bind ViewModel.ControllerSampleText, Mode=OneWay}" FontFamily="Consolas" FontSize="18" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16">
                <Button x:Name="CopyDiagnosticsButton" Style="{StaticResource ConsoleSmallButton}" Height="56" Padding="24,0" Command="{x:Bind ViewModel.CopyControllerDiagnosticsCommand}">
                    <TextBlock Text="{x:Bind ViewModel.Texts.CopyDiagnostics, Mode=OneWay}"/>
                </Button>
                <Button Style="{StaticResource ConsoleSmallButton}" Height="56" Padding="24,0" Command="{x:Bind ViewModel.CloseControllerTestCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ───────────── Active session ───────────── -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" MaxWidth="720"
                    Visibility="{x:Bind ViewModel.IsConsoleActive, Mode=OneWay}">
            <Border Width="120" Height="120" CornerRadius="60" HorizontalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE7FC;" FontSize="52" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.Texts.ActiveTitle, Mode=OneWay}" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.ActiveDescText, Mode=OneWay}" FontSize="20" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button x:Name="RestoreButton" Style="{StaticResource ConsolePlayButton}" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Command="{x:Bind ViewModel.RestoreNowCommand}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <FontIcon Glyph="&#xE7A7;" FontSize="24"/>
                    <TextBlock Text="{x:Bind ViewModel.Texts.BackToPc, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" Width="220" Visibility="{x:Bind ViewModel.IsRestoring, Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.ConsoleActiveHintText, Mode=OneWay}" FontSize="17" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>

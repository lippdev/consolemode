<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConsoleMode.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ConsoleMode.ViewModels">

    <Grid>
        <!-- Idle: pick the game screen, then one click. -->
        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
            <Border Style="{StaticResource Card}" Padding="22,18,22,22">
                <StackPanel>
                    <TextBlock Text="Suas telas" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Clique na tela onde você quer jogar. As outras são desligadas enquanto você joga e voltam ao sair."/>

                    <Grid MinHeight="176" Margin="0,18,0,0">
                        <ProgressRing Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.ShowTiles, Mode=OneWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MonitorRowViewModel">
                                    <Button Style="{StaticResource TileBtn}" VerticalAlignment="Bottom"
                                            Width="{x:Bind TileWidth, Mode=OneWay}"
                                            Height="{x:Bind TileHeight, Mode=OneWay}"
                                            Background="{x:Bind TileBackground, Mode=OneWay}"
                                            BorderBrush="{x:Bind TileBorder, Mode=OneWay}"
                                            Opacity="{x:Bind TileOpacity, Mode=OneWay}"
                                            Click="{x:Bind MakeFocus}"
                                            ToolTipService.ToolTip="{x:Bind Title}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Style="{StaticResource IconText}" FontSize="13"
                                                           Text="{x:Bind RoleGlyph, Mode=OneWay}"
                                                           Foreground="{x:Bind RoleBrush, Mode=OneWay}"/>
                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                           Text="{x:Bind RoleLabel, Mode=OneWay}"
                                                           Foreground="{x:Bind RoleBrush, Mode=OneWay}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="{x:Bind Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Grid.Row="3" Text="{x:Bind Details}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7F4;" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock Text="Nenhuma tela encontrada" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                            <Button Style="{StaticResource Btn}" HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.RefreshCommand}" Content="Tentar de novo"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource BtnPrimary}" Height="64" HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.StartCommand}"
                    IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" FontSize="18"
                               Foreground="{StaticResource DarkTextBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.StartButtonText, Mode=OneWay}" FontSize="18"/>
                </StackPanel>
            </Button>

            <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" HorizontalAlignment="Center"
                       TextAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="22"/>
        </StackPanel>

        <!-- Active: a single way back. -->
        <Border Style="{StaticResource Card}" Padding="28" VerticalAlignment="Top"
                Visibility="{x:Bind ViewModel.IsConsoleActive, Mode=OneWay}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7FC;" Foreground="{StaticResource AccentBrush}" FontSize="22"/>
                    <TextBlock Text="Modo console ativo" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.ActiveDescText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"
                           FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                <Button Style="{StaticResource Btn}" Height="48" Margin="0,22,0,0" HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.RestoreNowCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" FontSize="14"/>
                        <TextBlock Text="Restaurar agora"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConsoleMode.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ConsoleMode.ViewModels"
    xmlns:controls="using:ConsoleMode.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls">

    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="36,4,36,28">

        <!-- ───────────── Idle: choose screens, then play ───────────── -->
        <Grid RowSpacing="16" Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.Texts.HomeHeading, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.Texts.HomeDescription, Mode=OneWay}"/>
                </StackPanel>
                <InfoBar IsOpen="{x:Bind ViewModel.IsUpdateOpen, Mode=TwoWay}" Severity="Success"
                         Title="{x:Bind ViewModel.UpdateTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}">
                    <InfoBar.IconSource>
                        <FontIconSource Glyph="&#xE896;"/>
                    </InfoBar.IconSource>
                    <InfoBar.ActionButton>
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ApplyUpdateCommand}"
                                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.UpdateActionText, Mode=OneWay}"/>
                                <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsUpdating, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsUpdating, Mode=OneWay}"
                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="-12,0,0,8">
                            <HyperlinkButton Content="{x:Bind ViewModel.Texts.ReleaseNews, Mode=OneWay}" Command="{x:Bind ViewModel.OpenReleasePageCommand}"/>
                            <HyperlinkButton Content="{x:Bind ViewModel.Texts.IgnoreUpdate, Mode=OneWay}" Command="{x:Bind ViewModel.SkipUpdateCommand}"/>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
                <InfoBar IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                         Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"/>
            </StackPanel>

            <!-- Screen map card -->
            <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid MinHeight="250" Padding="24,20">
                        <ProgressRing Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>

                        <!-- Screens drawn where they sit on the desktop, like Windows display settings. -->
                        <ItemsControl x:Name="MonitorMap" ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.ShowTiles, Mode=OneWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:MonitorLayoutPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MonitorRowViewModel">
                                    <Grid Width="{x:Bind TileWidth, Mode=OneWay}" Height="{x:Bind TileHeight, Mode=OneWay}">
                                        <Button Style="{StaticResource MonitorTileButton}"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                Opacity="{x:Bind TileOpacity, Mode=OneWay}"
                                                Background="{x:Bind TileBackground, Mode=OneWay}"
                                                BorderBrush="{x:Bind TileBorder, Mode=OneWay}"
                                                Click="{x:Bind Select}"
                                                DoubleTapped="{x:Bind MakeFocus}"
                                                AutomationProperties.Name="{x:Bind Name}"
                                                ToolTipService.ToolTip="{x:Bind Title}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                                <FontIcon Glyph="{x:Bind RoleGlyph, Mode=OneWay}" FontSize="18"
                                                          Foreground="{x:Bind TileForeground, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextAlignment="Center"
                                                           TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                           Foreground="{x:Bind TileForeground, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind RoleLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{x:Bind TileSecondaryForeground, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Button>
                                        <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="1.5" StrokeDashArray="3,2"
                                                   Stroke="{ThemeResource TextFillColorTertiaryBrush}" IsHitTestVisible="False"
                                                   Visibility="{x:Bind IsOff}"/>
                                        <Border CornerRadius="9" BorderThickness="2" Margin="-4" IsHitTestVisible="False"
                                                BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                                Visibility="{x:Bind IsSelected, Mode=OneWay}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}">
                            <FontIcon Glyph="&#xE7F4;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.Texts.NoDisplays, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <Button HorizontalAlignment="Center" Content="{x:Bind ViewModel.Texts.TryAgain, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshCommand}"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-12,0"
                                Background="Transparent" BorderThickness="0" Padding="8"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Texts.RefreshDisplaysTooltip, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.Texts.RefreshDisplaysName, Mode=OneWay}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                    </Grid>

                    <!-- Selected screen: what it does while you play -->
                    <Grid Grid.Row="1" Padding="20,14" ColumnSpacing="16"
                          BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          Visibility="{x:Bind ViewModel.HasSelectedMonitor, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.SelectedMonitor.Name, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedMonitor.Details, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ctk:Segmented x:Name="RoleSelector" Grid.Column="1" VerticalAlignment="Center"
                                       SelectedIndex="{x:Bind ViewModel.SelectedMonitor.RoleIndex, Mode=TwoWay}"
                                       AutomationProperties.Name="{x:Bind ViewModel.Texts.RoleQuestion, Mode=OneWay}">
                            <ctk:SegmentedItem Content="{x:Bind ViewModel.Texts.RolePlayHere, Mode=OneWay}">
                                <ctk:SegmentedItem.Icon>
                                    <FontIcon Glyph="&#xE7FC;"/>
                                </ctk:SegmentedItem.Icon>
                            </ctk:SegmentedItem>
                            <ctk:SegmentedItem Content="{x:Bind ViewModel.Texts.RoleTurnOff, Mode=OneWay}">
                                <ctk:SegmentedItem.Icon>
                                    <FontIcon Glyph="&#xE7E8;"/>
                                </ctk:SegmentedItem.Icon>
                            </ctk:SegmentedItem>
                            <ctk:SegmentedItem Content="{x:Bind ViewModel.Texts.RoleKeepOn, Mode=OneWay}">
                                <ctk:SegmentedItem.Icon>
                                    <FontIcon Glyph="&#xE7F4;"/>
                                </ctk:SegmentedItem.Icon>
                            </ctk:SegmentedItem>
                        </ctk:Segmented>
                    </Grid>
                </Grid>
            </Border>

            <!-- Summary + primary action -->
            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SummaryTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SummaryItems, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Style="{StaticResource ChipBorder}" ToolTipService.ToolTip="{x:Bind}">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextBlockStyle}"
                                               MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Height="40" Width="40" Padding="0" Command="{x:Bind ViewModel.SwitchUiCommand}" CommandParameter="console"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Texts.SwitchToConsole, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.Texts.SwitchToConsole, Mode=OneWay}">
                        <FontIcon Glyph="&#xE7FC;" FontSize="14"/>
                    </Button>
                    <Button Height="40" Width="40" Padding="0" Command="{x:Bind ViewModel.OpenFeedbackCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Texts.SendFeedback, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.Texts.SendFeedback, Mode=OneWay}">
                        <FontIcon Glyph="&#xED15;" FontSize="14"/>
                    </Button>
                    <Button Height="40" Padding="14,0" Command="{x:Bind ViewModel.OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="14"/>
                            <TextBlock Text="{x:Bind ViewModel.Texts.Settings, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Height="40" Padding="22,0" MinWidth="160"
                            Command="{x:Bind ViewModel.StartCommand}"
                            IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock Text="{x:Bind ViewModel.StartButtonText, Mode=OneWay}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ───────────── First-run tour (coach marks on the real controls) ───────────── -->
        <TeachingTip Target="{x:Bind MonitorMap}" PreferredPlacement="Top" IsLightDismissEnabled="False"
                     IsOpen="{x:Bind ViewModel.IsTourMap, Mode=OneWay}"
                     Title="{x:Bind ViewModel.Texts.TourMapTitle, Mode=OneWay}"
                     Subtitle="{x:Bind ViewModel.TourMapText, Mode=OneWay}"
                     ActionButtonContent="{x:Bind ViewModel.Texts.Next, Mode=OneWay}" ActionButtonCommand="{x:Bind ViewModel.TourNextCommand}"
                     CloseButtonContent="{x:Bind ViewModel.Texts.SkipTour, Mode=OneWay}" Closed="{x:Bind ViewModel.OnTourTipClosed}">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xE7F4;"/>
            </TeachingTip.IconSource>
        </TeachingTip>
        <TeachingTip Target="{x:Bind RoleSelector}" PreferredPlacement="Top" IsLightDismissEnabled="False"
                     IsOpen="{x:Bind ViewModel.IsTourRole, Mode=OneWay}"
                     Title="{x:Bind ViewModel.Texts.TourRoleTitle, Mode=OneWay}"
                     Subtitle="{x:Bind ViewModel.Texts.TourRoleDescription, Mode=OneWay}"
                     ActionButtonContent="{x:Bind ViewModel.Texts.Next, Mode=OneWay}" ActionButtonCommand="{x:Bind ViewModel.TourNextCommand}"
                     CloseButtonContent="{x:Bind ViewModel.Texts.SkipTour, Mode=OneWay}" Closed="{x:Bind ViewModel.OnTourTipClosed}">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xE7E8;"/>
            </TeachingTip.IconSource>
        </TeachingTip>
        <TeachingTip Target="{x:Bind PlayButton}" PreferredPlacement="TopLeft" IsLightDismissEnabled="False"
                     IsOpen="{x:Bind ViewModel.IsTourPlay, Mode=OneWay}"
                     Title="{x:Bind ViewModel.Texts.TourPlayTitle, Mode=OneWay}"
                     Subtitle="{x:Bind ViewModel.Texts.TourPlayDescription, Mode=OneWay}"
                     ActionButtonContent="{x:Bind ViewModel.Texts.GotIt, Mode=OneWay}" ActionButtonCommand="{x:Bind ViewModel.TourNextCommand}"
                     Closed="{x:Bind ViewModel.OnTourTipClosed}">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xE768;"/>
            </TeachingTip.IconSource>
            <HyperlinkButton Content="{x:Bind ViewModel.Texts.CreateDesktopShortcut, Mode=OneWay}" Margin="-12,4,0,0"
                             Command="{x:Bind ViewModel.CreateShortcutCommand}"/>
        </TeachingTip>

        <!-- ───────────── Active: one way back ───────────── -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460"
                    Visibility="{x:Bind ViewModel.IsConsoleActive, Mode=OneWay}">
            <Border Width="88" Height="88" CornerRadius="44" HorizontalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE7FC;" FontSize="38" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.Texts.ActiveTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="{x:Bind ViewModel.ActiveDescText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Height="40" Padding="22,0" Margin="0,8,0,0"
                    Command="{x:Bind ViewModel.RestoreNowCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7A7;" FontSize="14"/>
                    <TextBlock Text="{x:Bind ViewModel.Texts.RestoreNow, Mode=OneWay}" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" Width="160" Visibility="{x:Bind ViewModel.IsRestoring, Mode=OneWay}"/>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="{x:Bind ViewModel.Texts.RunningInTray, Mode=OneWay}"/>
        </StackPanel>

        <!-- Toast: a controller was connected (shown for a few seconds, Desktop interface only) -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,84" Padding="16,10"
                CornerRadius="8" BorderThickness="1" IsHitTestVisible="False"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                Visibility="{x:Bind ViewModel.IsControllerToastOpen, Mode=OneWay}">
            <Border.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="24"/>
                </TransitionCollection>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE7FC;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.Texts.ControllerHintDesktop, Mode=OneWay}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

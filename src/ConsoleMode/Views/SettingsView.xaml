<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConsoleMode.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ConsoleMode.ViewModels"
    xmlns:controls="using:ConsoleMode.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Padding="0,0,14,0">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource Card}" Padding="18,14" Background="{StaticResource AccentDarkBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        Visibility="{x:Bind ViewModel.IsFirstRun, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Bem-vindo! Configure uma vez." FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource TextBrush}"
                                   Text="Diga em qual tela você joga e quais devem desligar. Depois é só 1 clique na tela inicial, ou no atalho da Área de Trabalho."/>
                    </StackPanel>
                </Border>

                <!-- Screens -->
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Telas" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14"
                                   Text="Clique numa tela para ajustar. Uma tela para jogar; as marcadas como Desligar somem enquanto você joga. Tracejadas estão desligadas agora."/>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneWay}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:MonitorLayoutPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MonitorRowViewModel">
                                    <Grid Width="{x:Bind TileWidth, Mode=OneWay}" Height="{x:Bind TileHeight, Mode=OneWay}"
                                          Opacity="{x:Bind TileOpacity, Mode=OneWay}">
                                        <Button Style="{StaticResource TileBtn}"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                Background="{x:Bind TileBackground, Mode=OneWay}"
                                                BorderBrush="{x:Bind TileBorder, Mode=OneWay}"
                                                Click="{x:Bind Select}"
                                                ToolTipService.ToolTip="{x:Bind Title}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Style="{StaticResource IconText}" FontSize="13"
                                                               Text="{x:Bind RoleGlyph, Mode=OneWay}"
                                                               Foreground="{x:Bind RoleBrush, Mode=OneWay}"/>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Text="{x:Bind RoleLabel, Mode=OneWay}"
                                                               Foreground="{x:Bind RoleBrush, Mode=OneWay}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="2" Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="WrapWholeWords"
                                                           MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
                                            </Grid>
                                        </Button>
                                        <Rectangle RadiusX="12" RadiusY="12" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5"
                                                   StrokeDashArray="4,3" Margin="1" IsHitTestVisible="False"
                                                   Visibility="{x:Bind IsOff}"/>
                                        <Border CornerRadius="14" BorderThickness="3" Margin="-4" IsHitTestVisible="False"
                                                BorderBrush="{StaticResource TextBrush}"
                                                Visibility="{x:Bind IsSelected, Mode=OneWay}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Selected screen -->
                        <Border Style="{StaticResource Card}" Background="{StaticResource CardBrush}" Padding="16,12" Margin="0,16,0,0"
                                Visibility="{x:Bind ViewModel.HasSelectedMonitor, Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedMonitor.Title, Mode=OneWay}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedMonitor.Details, Mode=OneWay}" Style="{StaticResource Hint}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          Header="Papel"
                                          ItemsSource="{x:Bind vm:MonitorRowViewModel.RoleOptions}"
                                          SelectedIndex="{x:Bind ViewModel.SelectedMonitor.RoleIndex, Mode=TwoWay}"/>
                                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          Header="Resolução / Hz ao jogar"
                                          ItemsSource="{x:Bind ViewModel.SelectedMonitor.Modes, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedMonitor.SelectedMode, Mode=TwoWay}"
                                          DisplayMemberPath="Text"/>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,0"
                                   Text="Telas desligadas usam resoluções do cache ou estimadas, aplicadas quando ligam."/>
                        <TextBlock Text="Como desligar as outras telas" Foreground="{StaticResource TextBrush}" Margin="0,8,0,6"/>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.HideStrategies, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedHideStrategy, Mode=TwoWay}"
                                  DisplayMemberPath="Text"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,0"
                                   Text="Desconectar: desativa no Windows (rápido e confiável). Cortinas: cobre com preto, sem mexer no layout. DDC/CI: apaga o painel pelo hardware."/>
                    </StackPanel>
                </Border>

                <!-- What opens -->
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="O que abrir" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <RadioButton GroupName="fsmode" IsChecked="{x:Bind ViewModel.ModeBigPicture, Mode=TwoWay}">
                            <TextBlock Text="Steam Big Picture (recomendado)" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        </RadioButton>
                        <TextBlock Style="{StaticResource Hint}" Margin="30,2,0,12"
                                   Text="Abre na tela de jogo. Ao fechar o Big Picture, suas telas voltam sozinhas."/>
                        <RadioButton GroupName="fsmode" IsChecked="{x:Bind ViewModel.ModePlaynite, Mode=TwoWay}"
                                     IsEnabled="{x:Bind ViewModel.IsPlayniteAvailable, Mode=OneWay}">
                            <TextBlock Text="Playnite (tela cheia)" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        </RadioButton>
                        <TextBlock Style="{StaticResource Hint}" Margin="30,2,0,12" Text="{x:Bind ViewModel.PlayniteDesc, Mode=OneWay}"/>
                        <RadioButton GroupName="fsmode" IsChecked="{x:Bind ViewModel.ModeXbox, Mode=TwoWay}">
                            <TextBlock Text="Modo Xbox (Win+F11) · experimental" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        </RadioButton>
                        <TextBlock Style="{StaticResource Hint}" Margin="30,2,0,0" Foreground="{StaticResource WarningBrush}"
                                   Text="Envia Win+F11. A volta é manual: Restaurar agora ou o menu da bandeja."/>
                    </StackPanel>
                </Border>

                <!-- Audio -->
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Áudio" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.AudioOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedAudio, Mode=TwoWay}"
                                  DisplayMemberPath="Text"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,0" Text="{x:Bind ViewModel.AudioHintText, Mode=OneWay}"/>
                    </StackPanel>
                </Border>

                <!-- Optional extras -->
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Extras opcionais" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="Ligar HDR na tela de jogo" IsChecked="{x:Bind ViewModel.HdrEnable, Mode=TwoWay}"/>
                            <CheckBox Grid.Column="1" Content="Ligar VRR (taxa variável)" IsChecked="{x:Bind ViewModel.VrrEnable, Mode=TwoWay}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,0"
                                   Text="VRR aqui só liga o ajuste do Windows; o ideal é ativar também no painel da GPU (NVIDIA/AMD)."/>

                        <TextBlock Text="Limite de FPS (RTSS) · evita tearing" Foreground="{StaticResource TextBrush}" Margin="0,16,0,6"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox Width="220"
                                      IsEnabled="{x:Bind ViewModel.IsFpsAvailable, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.FpsOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedFps, Mode=TwoWay}"
                                      DisplayMemberPath="Text"/>
                            <TextBox Width="90" PlaceholderText="FPS"
                                     IsEnabled="{x:Bind ViewModel.IsFpsAvailable, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.ShowCustomFps, Mode=OneWay}"
                                     Text="{x:Bind ViewModel.CustomFpsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,0" Text="{x:Bind ViewModel.FpsStatusText, Mode=OneWay}"/>
                    </StackPanel>
                </Border>

                <!-- Shortcut -->
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Atalho de 1 clique" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="Cria 'Modo Console' na Área de Trabalho. Ele entra no modo console direto, sem abrir esta janela. Dá pra fixar na barra de tarefas."/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Btn}" VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.CreateShortcutCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE71B;" FontSize="14"/>
                                <TextBlock Text="Criar atalho"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Style="{StaticResource BtnPrimary}" Width="180" Height="44" Margin="0,14,14,0"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.CloseSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="14" Foreground="{StaticResource DarkTextBrush}"/>
                <TextBlock Text="Concluir"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>

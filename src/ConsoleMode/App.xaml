<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ConsoleMode.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand accent (green). Fluent picks Dark1-3 on light theme and Light1-3 on dark theme. -->
            <Color x:Key="SystemAccentColor">#2FB88C</Color>
            <Color x:Key="SystemAccentColorLight1">#4FCFA3</Color>
            <Color x:Key="SystemAccentColorLight2">#6FDDB8</Color>
            <Color x:Key="SystemAccentColorLight3">#9BEACF</Color>
            <Color x:Key="SystemAccentColorDark1">#1E9C74</Color>
            <Color x:Key="SystemAccentColorDark2">#15805F</Color>
            <Color x:Key="SystemAccentColorDark3">#0E634A</Color>

            <x:Double x:Key="PageMaxWidth">880</x:Double>

            <!-- Font of the console interface (Inter, variable, shipped in Assets\Fonts). Windows falls back to
                 Segoe UI if the file can't be loaded. The console views also set it as ContentControlThemeFontFamily,
                 so buttons and other controls pick it up too. -->
            <FontFamily x:Key="ConsoleFontFamily">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>

            <!-- Screen tile in the layout map; colors come from the row's role (MonitorRowViewModel). -->
            <Style x:Key="MonitorTileButton" TargetType="Button">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1"/>
                                                <Setter Target="Root.Opacity" Value="0.85"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                                <Border x:Name="Hover" Opacity="0" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" IsHitTestVisible="False"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rounded pill used for the "ao jogar" summary. -->
            <Style x:Key="ChipBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="10,3"/>
            </Style>

            <!-- Template of every console surface (cards, rows, categories, tabs, round buttons): the hover is a soft
                 veil that fades in and out, a press sinks the tile a little. No grey Fluent fills or dimmed text. -->
            <ControlTemplate x:Key="ConsoleSurfaceTemplate" TargetType="Button">
                <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="Scale"/>
                    </Grid.RenderTransform>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualStateGroup.Transitions>
                                <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08"/>
                                <VisualTransition GeneratedDuration="0:0:0.2">
                                    <VisualTransition.GeneratedEasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </VisualTransition.GeneratedEasingFunction>
                                </VisualTransition>
                            </VisualStateGroup.Transitions>
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0"/>
                                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0"/>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
                    <Border x:Name="Hover" Opacity="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
            </ControlTemplate>

            <!-- Console (10-foot) interface: flat dark tiles over the game art, no hairlines; the focus is a clean
                 white outline and the tile grows a little (see ConsoleHomeView), like a console home. -->
            <Style x:Key="ConsoleCard" TargetType="Button">
                <Setter Property="MinWidth" Value="220"/>
                <Setter Property="MinHeight" Value="120"/>
                <Setter Property="Padding" Value="22,18"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="#D9131820"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Template" Value="{StaticResource ConsoleSurfaceTemplate}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
                <Setter Property="FocusVisualPrimaryThickness" Value="3"/>
                <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
                <Setter Property="FocusVisualMargin" Value="-5"/>
            </Style>
            <!-- One launcher in the console Home row: a square tile with the launcher's colours. -->
            <Style x:Key="LaunchTileButton" TargetType="Button" BasedOn="{StaticResource ConsoleCard}">
                <Setter Property="Width" Value="156"/>
                <Setter Property="Height" Value="156"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="12,14"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="FocusVisualMargin" Value="-6"/>
            </Style>
            <!-- A tab in the console top bar: plain text, the active one lit with a short underline. -->
            <Style x:Key="ConsoleTab" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource ConsoleSurfaceTemplate}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <!-- Reached with LB / RB (or a click), never by moving the focus. -->
                <Setter Property="IsTabStop" Value="False"/>
            </Style>
            <Style x:Key="TabUnderline" TargetType="Border">
                <Setter Property="Height" Value="3"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Margin" Value="0,0,0,-8"/>
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
            </Style>
            <!-- Round icon button in the console top bar (settings, desktop). -->
            <Style x:Key="ConsoleNavButton" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource ConsoleSurfaceTemplate}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Width" Value="52"/>
                <Setter Property="Height" Value="52"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="26"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
                <Setter Property="FocusVisualPrimaryThickness" Value="3"/>
                <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
                <Setter Property="FocusVisualMargin" Value="-4"/>
            </Style>
            <!-- Round badge for controller button hints (A, B, ☰, Y). Shared by the console screen and the session menu. -->
            <Style x:Key="HintBadge" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- One settings row in the console settings list: label left, value right. -->
            <Style x:Key="ConsoleRow" TargetType="Button" BasedOn="{StaticResource ConsoleCard}">
                <Setter Property="MinHeight" Value="72"/>
                <Setter Property="Height" Value="72"/>
                <Setter Property="Padding" Value="24,0"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Background" Value="#14FFFFFF"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualMargin" Value="-3"/>
            </Style>
            <!-- A category in the console System tab's left column: just its name, no tile. -->
            <Style x:Key="ConsoleCategory" TargetType="Button" BasedOn="{StaticResource ConsoleRow}">
                <Setter Property="MinHeight" Value="60"/>
                <Setter Property="Height" Value="60"/>
                <Setter Property="Padding" Value="20,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="ConsolePlayButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Height" Value="64"/>
                <Setter Property="MinWidth" Value="300"/>
                <Setter Property="Padding" Value="36,0"/>
                <Setter Property="CornerRadius" Value="32"/>
                <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
                <Setter Property="FocusVisualPrimaryThickness" Value="4"/>
                <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
                <Setter Property="FocusVisualMargin" Value="-6"/>
            </Style>
            <Style x:Key="ConsoleSmallButton" TargetType="Button">
                <Setter Property="Height" Value="44"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                <Setter Property="FocusVisualPrimaryThickness" Value="4"/>
                <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
                <Setter Property="FocusVisualMargin" Value="-6"/>
            </Style>

            <Style x:Key="SettingsSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ConsoleMode.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand accent (green). Fluent picks Dark1-3 on light theme and Light1-3 on dark theme. -->
            <Color x:Key="SystemAccentColor">#2FB88C</Color>
            <Color x:Key="SystemAccentColorLight1">#4FCFA3</Color>
            <Color x:Key="SystemAccentColorLight2">#6FDDB8</Color>
            <Color x:Key="SystemAccentColorLight3">#9BEACF</Color>
            <Color x:Key="SystemAccentColorDark1">#1E9C74</Color>
            <Color x:Key="SystemAccentColorDark2">#15805F</Color>
            <Color x:Key="SystemAccentColorDark3">#0E634A</Color>

            <x:Double x:Key="PageMaxWidth">880</x:Double>

            <!-- Screen tile in the layout map; colors come from the row's role (MonitorRowViewModel). -->
            <Style x:Key="MonitorTileButton" TargetType="Button">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Hover.Opacity" Value="1"/>
                                                <Setter Target="Root.Opacity" Value="0.85"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                                <Border x:Name="Hover" Opacity="0" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" IsHitTestVisible="False"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rounded pill used for the "ao jogar" summary. -->
            <Style x:Key="ChipBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="10,3"/>
            </Style>

            <!-- Console (10-foot) interface: big cards with a thick accent focus ring for controller navigation. -->
            <Style x:Key="ConsoleCard" TargetType="Button">
                <Setter Property="MinWidth" Value="220"/>
                <Setter Property="MinHeight" Value="120"/>
                <Setter Property="Padding" Value="22,18"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                <Setter Property="FocusVisualPrimaryThickness" Value="4"/>
                <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
                <Setter Property="FocusVisualMargin" Value="-6"/>
            </Style>
            <!-- One settings row in the console settings list: label left, value right. -->
            <Style x:Key="ConsoleRow" TargetType="Button" BasedOn="{StaticResource ConsoleCard}">
                <Setter Property="MinHeight" Value="76"/>
                <Setter Property="Height" Value="76"/>
                <Setter Property="Padding" Value="24,0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ConsolePlayButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Height" Value="64"/>
                <Setter Property="MinWidth" Value="280"/>
                <Setter Property="Padding" Value="32,0"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
                <Setter Property="FocusVisualPrimaryThickness" Value="4"/>
                <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
                <Setter Property="FocusVisualMargin" Value="-6"/>
            </Style>
            <Style x:Key="ConsoleSmallButton" TargetType="Button">
                <Setter Property="Height" Value="44"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                <Setter Property="FocusVisualPrimaryThickness" Value="4"/>
                <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
                <Setter Property="FocusVisualMargin" Value="-6"/>
            </Style>

            <Style x:Key="SettingsSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

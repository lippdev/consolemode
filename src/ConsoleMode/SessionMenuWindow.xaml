<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ConsoleMode.SessionMenuWindow"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ConsoleMode.ViewModels"
    Title="Console Mode">

    <!-- Over the game, like a console's quick menu: dark, big rows, controller-first. -->
    <Grid x:Name="Root" Background="#F20F1418" Padding="40,32" RowSpacing="18" RequestedTheme="Dark"
          XYFocusKeyboardNavigation="Enabled">
        <Grid.Resources>
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="RowValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="MaxWidth" Value="360"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title, clock, elapsed, controller -->
        <Grid>
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Texts.SessionMenuTitle, Mode=OneWay}" FontSize="30" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="{x:Bind ViewModel.SessionElapsed, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="·" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.SessionControllerText, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.SessionClock, Mode=OneWay}" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        </Grid>

        <!-- Rows -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="10">
                <Button x:Name="FirstRow" Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CloseSessionMenuCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon Glyph="&#xE768;" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.BackToGame, Mode=OneWay}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="VolumeRow" Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.ToggleMuteCommand}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE767;" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.VolumeRow, Mode=OneWay}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="◀" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.VolumeText, Mode=OneWay}" MinWidth="64" TextAlignment="Center"/>
                            <TextBlock Text="▶" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenSessionPickerCommand}" CommandParameter="mode">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7F4;" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.ResolutionRefreshCard, Mode=OneWay}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.SessionModeText, Mode=OneWay}"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenSessionPickerCommand}" CommandParameter="audio">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7F5;" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.AudioOutputCard, Mode=OneWay}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.SessionAudioText, Mode=OneWay}"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenSessionPickerCommand}" CommandParameter="fps"
                        Visibility="{x:Bind ViewModel.IsFpsMenuAvailable, Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEC4A;" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.FpsCard, Mode=OneWay}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.SessionFpsText, Mode=OneWay}"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.ToggleSessionHdrCommand}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE706;" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.HdrCard, Mode=OneWay}"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.OnOff(ViewModel.SessionHdrOn), Mode=OneWay}"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource ConsoleRow}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon Glyph="&#xE714;" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.RecordRowText, Mode=OneWay}"/>
                    </StackPanel>
                </Button>

                <Border Height="6"/>
                <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.RestoreFromMenuCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon Glyph="&#xE7A7;" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.BackToPc, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.ExitFromMenuCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon Glyph="&#xE7E8;" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.ExitConsoleMode, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Hints -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="22" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintConfirm, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                <TextBlock Text="{x:Bind ViewModel.Texts.HintSelect, Mode=OneWay}" VerticalAlignment="Center" FontSize="15"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}" VerticalAlignment="Center" FontSize="15"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Style="{StaticResource HintBadge}"><TextBlock Text="◀ ▶" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                <TextBlock Text="{x:Bind ViewModel.Texts.HintVolume, Mode=OneWay}" VerticalAlignment="Center" FontSize="15"/>
            </StackPanel>
        </StackPanel>

        <!-- Sub-picker (resolution / audio / FPS) -->
        <Grid Grid.RowSpan="3" Margin="-40,-32" Visibility="{x:Bind ViewModel.IsSessionPickerOpen, Mode=OneWay}" Background="#F00F1418">
            <Grid MaxWidth="640" VerticalAlignment="Center" RowSpacing="16" Padding="40,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.SessionPickerTitle, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <ScrollViewer Grid.Row="1" MaxHeight="480" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="PickerList" ItemsSource="{x:Bind ViewModel.SessionPickerOptions, Mode=OneWay}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PickerItem">
                                <Button Style="{StaticResource ConsoleRow}" Height="64" Width="560"
                                        Command="{Binding ViewModel.PickSessionOptionCommand, ElementName=Page}" CommandParameter="{x:Bind}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="22"><FontIcon Glyph="&#xE73E;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind IsSelected}"/></Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="19" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Busy veil while a blocking change runs -->
        <Grid Grid.RowSpan="3" Margin="-40,-32" Visibility="{x:Bind ViewModel.IsSessionMenuBusy, Mode=OneWay}" Background="#990F1418">
            <ProgressRing IsActive="True" Width="56" Height="56"/>
        </Grid>
    </Grid>
</Window>

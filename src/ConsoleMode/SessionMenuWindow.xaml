<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ConsoleMode.SessionMenuWindow"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ConsoleMode.ViewModels"
    xmlns:controls="using:ConsoleMode.Controls"
    Title="Console Mode">

    <!-- Like Steam's Shift + Tab: the whole screen, the game dimmed behind, a side panel with the
         options and the open windows in the middle. Controller-first. -->
    <!-- Background is set in code (ApplyMaterial): glass or solid depending on Windows' transparency setting -->
    <Grid x:Name="Root" Background="Transparent" Padding="56,36,56,30" RowSpacing="22" RequestedTheme="Dark"
          XYFocusKeyboardNavigation="Enabled">
        <Grid.Resources>
          <ResourceDictionary>
            <!-- Colour tokens of the menu. In Windows' high-contrast mode they become the system colours. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="MenuIconFill" Color="#26FFFFFF"/>
                    <SolidColorBrush x:Key="MenuTextSecondary" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="MenuTextTertiary" Color="#80FFFFFF"/>
                    <SolidColorBrush x:Key="MenuRule" Color="#26FFFFFF"/>
                    <SolidColorBrush x:Key="MenuVeil" Color="#99070A0E"/>
                    <SolidColorBrush x:Key="MenuPickerVeil" Color="#F2070A0E"/>
                    <SolidColorBrush x:Key="MenuDialogFill" Color="#FF171F29"/>
                    <SolidColorBrush x:Key="MenuDanger" Color="#FFC42B1C"/>
                    <SolidColorBrush x:Key="MenuOnDanger" Color="#FFFFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="MenuIconFill" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="MenuTextSecondary" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="MenuTextTertiary" Color="{ThemeResource SystemColorGrayTextColor}"/>
                    <SolidColorBrush x:Key="MenuRule" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="MenuVeil" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="MenuPickerVeil" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="MenuDialogFill" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="MenuDanger" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="MenuOnDanger" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="RowValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="MaxWidth" Value="360"/>
            </Style>
            <!-- One option in the side panel: icon in a circle, what it is, its value. -->
            <Style x:Key="SideRow" TargetType="Button" BasedOn="{StaticResource ConsoleCard}">
                <Setter Property="Height" Value="74"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <!-- No hairline (the panel is the container) and the selection ring sits on the edge of the row,
                     not five pixels out with a gap of background between them. -->
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualMargin" Value="0"/>
                <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            </Style>
            <Style x:Key="WindowCard" TargetType="Button" BasedOn="{StaticResource ConsoleCard}">
                <!-- Every card fills its cell: a Button otherwise shrinks to its text, and short titles made smaller cards. -->
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualMargin" Value="0"/>
                <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            </Style>
            <Style x:Key="RowIcon" TargetType="Border">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="Background" Value="{ThemeResource MenuIconFill}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="TileLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{ThemeResource MenuTextSecondary}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="MaxLines" Value="1"/>
            </Style>
            <Style x:Key="TileValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="MaxLines" Value="1"/>
            </Style>
                  </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: who, how long, which pad; the clock on the right -->
        <Grid x:Name="HeaderPanel">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Width="54" Height="54" CornerRadius="27" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE7FC;" FontSize="26" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.Texts.SessionMenuTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <!-- Alpha: the menu also opens outside a session, to be tried without console mode -->
                        <Border Visibility="{x:Bind ViewModel.IsSessionMenuPreview, Mode=OneWay}" CornerRadius="11" Padding="11,2"
                                BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="{x:Bind ViewModel.Texts.SessionPreviewBadge, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.SessionElapsed, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource MenuTextSecondary}"
                                   Visibility="{x:Bind ViewModel.IsSessionMenuLive, Mode=OneWay}"/>
                        <TextBlock Text="·" FontSize="16" Foreground="{ThemeResource MenuTextTertiary}" Visibility="{x:Bind ViewModel.IsSessionMenuLive, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.SessionControllerText, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource MenuTextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.SessionClock, Mode=OneWay}" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Body: the options on the left, the open windows in the middle -->
        <Grid Grid.Row="1" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarPanel" CornerRadius="24" Padding="14" Background="#B3111820">
              <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <!-- Pinned, not part of the scrolling list: ControlFS, the controller-first file explorer (a separate,
                     open-source app from the same team). -->
                <Button x:Name="ControlFsRow" Tag="row" Style="{StaticResource SideRow}" Command="{x:Bind ViewModel.OpenControlFsCommand}"
                        AutomationProperties.Name="{x:Bind ViewModel.Texts.ControlFsCard, Mode=OneWay}">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF2B5C8F" Offset="0"/>
                            <GradientStop Color="#FF16263A" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="72" Height="48" CornerRadius="8">
                            <Image Source="{x:Bind ViewModel.ControlFsLogo}" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource TileValue}" FontSize="18" Text="{x:Bind ViewModel.Texts.ControlFsCard, Mode=OneWay}"/>
                            <TextBlock Style="{StaticResource TileLabel}" FontSize="14" Text="{x:Bind ViewModel.ControlFsRowText, Mode=OneWay}"/>
                            <!-- Installing from this row: the download fills the bar, the setup leaves it running. -->
                            <ProgressBar Minimum="0" Maximum="100" Height="4" CornerRadius="2" Margin="0,3,0,0"
                                         Value="{x:Bind ViewModel.ControlFsProgress, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind ViewModel.ControlFsSetupRunning, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.ControlFsInstalling, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="RowsPanel" Spacing="8">
                        <Button x:Name="FirstRow" Tag="row" Style="{StaticResource SideRow}" Command="{x:Bind ViewModel.CloseSessionMenuCommand}">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF2A8F69" Offset="0"/>
                                    <GradientStop Color="#FF17362F" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE768;" FontSize="19"/></Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource TileValue}" VerticalAlignment="Center" Text="{x:Bind ViewModel.Texts.BackToGame, Mode=OneWay}"/>
                            </Grid>
                        </Button>

                        <!-- A enters adjust mode: Left/Right change the volume, X/Square mutes, A or B leaves. -->
                        <Button x:Name="VolumeRow" Tag="row" Style="{StaticResource SideRow}" Click="OnVolumeClick">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE767;" FontSize="19"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <Grid>
                                        <TextBlock Style="{StaticResource TileLabel}" Text="{x:Bind ViewModel.Texts.VolumeRow, Mode=OneWay}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <TextBlock x:Name="VolumeLeft" Text="◀" FontSize="13" VerticalAlignment="Center" Visibility="Collapsed"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Style="{StaticResource TileValue}" FontSize="17" Text="{x:Bind ViewModel.VolumeText, Mode=OneWay}"/>
                                            <TextBlock x:Name="VolumeRight" Text="▶" FontSize="13" VerticalAlignment="Center" Visibility="Collapsed"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Minimum="0" Maximum="100" Height="6" CornerRadius="3" Value="{x:Bind ViewModel.VolumePercent, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Tag="row" Style="{StaticResource SideRow}" Command="{x:Bind ViewModel.OpenSessionPickerCommand}" CommandParameter="mode">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE7F4;" FontSize="19"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{x:Bind ViewModel.Texts.ResolutionRefreshCard, Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{x:Bind ViewModel.SessionModeText, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Tag="row" Style="{StaticResource SideRow}" Command="{x:Bind ViewModel.OpenSessionPickerCommand}" CommandParameter="audio">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE7F5;" FontSize="19"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{x:Bind ViewModel.Texts.AudioOutputCard, Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{x:Bind ViewModel.SessionAudioText, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Tag="row" Style="{StaticResource SideRow}" Command="{x:Bind ViewModel.OpenSessionPickerCommand}" CommandParameter="fps"
                                Visibility="{x:Bind ViewModel.IsFpsMenuAvailable, Mode=OneWay}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xEC4A;" FontSize="19"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{x:Bind ViewModel.Texts.FpsCard, Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{x:Bind ViewModel.SessionFpsText, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Tag="row" Style="{StaticResource SideRow}" Command="{x:Bind ViewModel.CycleFpsOverlayCommand}"
                                Visibility="{x:Bind ViewModel.IsFpsOverlayAvailable, Mode=OneWay}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE9D9;" FontSize="19"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{x:Bind ViewModel.Texts.FpsOverlayCard, Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{x:Bind ViewModel.SessionOverlayText, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Tag="row" Style="{StaticResource SideRow}" Command="{x:Bind ViewModel.ToggleSessionHdrCommand}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE706;" FontSize="19"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource TileLabel}" Text="{x:Bind ViewModel.Texts.HdrCard, Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{x:Bind ViewModel.OnOff(ViewModel.SessionHdrOn), Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Border Height="1" Margin="8,6" Background="{ThemeResource MenuRule}"/>

                        <!-- The two ways out: the main one filled -->
                        <Button Tag="row" Style="{StaticResource SideRow}" Height="64" Command="{x:Bind ViewModel.RestoreFromMenuCommand}"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                FocusVisualPrimaryBrush="White">
                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE7A7;" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.BackToPcText, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="row" Style="{StaticResource SideRow}" Height="64" Command="{x:Bind ViewModel.ExitFromMenuCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE7E8;" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource RowLabel}" FontSize="19" Text="{x:Bind ViewModel.Texts.ExitConsoleMode, Mode=OneWay}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>

            <!-- The open windows, front to back: an Alt + Tab that is always on screen -->
            <Grid x:Name="WindowsPanel" Grid.Column="1" RowSpacing="14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="6,0,0,0">
                    <TextBlock Text="{x:Bind ViewModel.Texts.SessionWindowsCard, Mode=OneWay}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.SessionWindowsText, Mode=OneWay}" FontSize="18" Foreground="{ThemeResource MenuTextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Texts.SwitcherEmpty, Mode=OneWay}" FontSize="19"
                           Foreground="{ThemeResource MenuTextSecondary}" Margin="6,8,0,0" Visibility="{x:Bind ViewModel.SwitcherIsEmpty, Mode=OneWay}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="SwitcherList" IsTabStop="False" Margin="0,4,0,18" ItemsSource="{x:Bind ViewModel.SwitcherWindows, Mode=OneWay}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:WrapPanel Spacing="16"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SwitchWindowItem">
                                <Grid Width="250" Height="178">
                                  <Button Tag="card" Style="{StaticResource WindowCard}" Padding="18,16"
                                          Command="{Binding ViewModel.SwitchToWindowCommand, ElementName=Page}" CommandParameter="{x:Bind}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <!-- The program's own icon; the generic one in a circle only while there is none. -->
                                        <Grid Width="52" Height="52" HorizontalAlignment="Left">
                                            <Border CornerRadius="26" Background="{ThemeResource MenuIconFill}" Visibility="{x:Bind HasNoIcon, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE737;" FontSize="22"/>
                                            </Border>
                                            <Image Source="{x:Bind Icon, Mode=OneWay}" Width="48" Height="48" Stretch="Uniform"/>
                                        </Grid>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="2">
                                            <TextBlock Text="{x:Bind ProcessName}" FontSize="16" Foreground="{ThemeResource MenuTextSecondary}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                  </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Hints -->
        <StackPanel x:Name="HintsPanel" Grid.Row="2" Orientation="Horizontal" Spacing="26" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintConfirm, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                <TextBlock Text="{x:Bind ViewModel.Texts.HintSelect, Mode=OneWay}" VerticalAlignment="Center" FontSize="17"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                <TextBlock Text="{x:Bind ViewModel.Texts.BackToGame, Mode=OneWay}" VerticalAlignment="Center" FontSize="17"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintOption, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                <TextBlock Text="{x:Bind ViewModel.Texts.SwitcherCloseWindow, Mode=OneWay}" VerticalAlignment="Center" FontSize="17"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Style="{StaticResource HintBadge}"><TextBlock Text="◀ ▶" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                <TextBlock Text="{x:Bind ViewModel.Texts.HintVolume, Mode=OneWay}" VerticalAlignment="Center" FontSize="17"/>
            </StackPanel>
        </StackPanel>

        <!-- Sub-picker (resolution / audio / FPS) -->
        <Grid x:Name="PickerOverlay" Grid.RowSpan="3" Margin="-56,-36,-56,-30" Visibility="{x:Bind ViewModel.IsSessionPickerOpen, Mode=OneWay}" Background="{ThemeResource MenuPickerVeil}">
            <Grid x:Name="PickerCard" MaxWidth="640" VerticalAlignment="Center" RowSpacing="16" Padding="40,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.SessionPickerTitle, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="PickerList" IsTabStop="False" ItemsSource="{x:Bind ViewModel.SessionPickerOptions, Mode=OneWay}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PickerItem">
                                <Button Style="{StaticResource ConsoleRow}" Height="64" Width="560"
                                        Command="{Binding ViewModel.PickSessionOptionCommand, ElementName=Page}" CommandParameter="{x:Bind}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="22"><FontIcon Glyph="&#xE73E;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind IsSelected}"/></Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="19" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Confirm closing a window; the cancel action is focused by default. -->
        <Grid x:Name="CloseConfirmOverlay" Grid.RowSpan="3" Margin="-56,-36,-56,-30" Visibility="Collapsed"
              Background="{ThemeResource MenuPickerVeil}" IsTabStop="False">
            <Grid x:Name="CloseConfirmCard" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="24" Padding="32,30,32,28"
                  CornerRadius="24" Background="{ThemeResource MenuDialogFill}" BorderBrush="{ThemeResource MenuRule}" BorderThickness="1"
                  XYFocusKeyboardNavigation="Enabled">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.Texts.SwitcherCloseConfirmTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.Texts.SwitcherCloseConfirmBody, Mode=OneWay}" FontSize="17"
                               Foreground="{ThemeResource MenuTextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- The window in question, drawn like its card so it is recognised at a glance. -->
                <Grid Grid.Row="1" ColumnSpacing="16" Padding="18,16" CornerRadius="16" Background="{ThemeResource MenuIconFill}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="52" Height="52" VerticalAlignment="Center">
                        <Border x:Name="CloseConfirmGlyph" CornerRadius="26" Background="{ThemeResource MenuIconFill}">
                            <FontIcon Glyph="&#xE737;" FontSize="22"/>
                        </Border>
                        <Image x:Name="CloseConfirmIcon" Width="48" Height="48" Stretch="Uniform"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="CloseConfirmProcessText" FontSize="16" Foreground="{ThemeResource MenuTextSecondary}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <TextBlock x:Name="CloseConfirmTitleText" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="CancelCloseButton" Style="{StaticResource SideRow}" Height="64" Click="CancelCloseClick"
                            AutomationProperties.Name="{x:Bind ViewModel.Texts.ShortcutCancel, Mode=OneWay}">
                        <TextBlock Style="{StaticResource RowLabel}" FontSize="19" HorizontalAlignment="Center"
                                   Text="{x:Bind ViewModel.Texts.ShortcutCancel, Mode=OneWay}"/>
                    </Button>
                    <Button x:Name="ConfirmCloseButton" Grid.Column="1" Style="{StaticResource SideRow}" Height="64" Click="ConfirmCloseClick"
                            Background="{ThemeResource MenuDanger}" Foreground="{ThemeResource MenuOnDanger}"
                            AutomationProperties.Name="{x:Bind ViewModel.Texts.SwitcherCloseConfirmAction, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8BB;" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.Texts.SwitcherCloseConfirmAction, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- Busy veil while a blocking change runs -->
        <Grid Grid.RowSpan="3" Margin="-56,-36,-56,-30" Visibility="{x:Bind ViewModel.IsSessionMenuBusy, Mode=OneWay}" Background="{ThemeResource MenuVeil}">
            <ProgressRing IsActive="True" Width="56" Height="56"/>
        </Grid>
    </Grid>
</Window>

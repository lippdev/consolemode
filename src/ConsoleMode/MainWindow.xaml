<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ConsoleMode.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ConsoleMode.Views"
    Title="Console Mode">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The console interface takes the whole window and paints its background under the title bar (it leaves the
             top 48 px free itself), so there is no separate strip above it. -->
        <!-- ...in proportion to the window, like a console: laid out 1080 tall, whatever scale Windows is at (UiScaleHost) -->
        <Viewbox x:Name="UiScaleBox" Grid.RowSpan="2">
            <views:ConsoleHomeView x:Name="HomeView"/>
        </Viewbox>

        <!-- Title bar, drawn over the page: only a drag region, the interface has its own brand mark in its top bar. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent"/>
    </Grid>
</Window>

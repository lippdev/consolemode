<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ConsoleMode.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ConsoleMode.Views"
    Title="Console Mode">

    <Grid x:Name="RootGrid" Background="{StaticResource BgBrush}" Padding="28,18,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,4,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource AccentDarkBrush}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7FC;" FontSize="22"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Console Mode" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Do desktop pra TV com 1 clique — e de volta quando você fechar o jogo."
                               Foreground="{StaticResource MutedBrush}" Margin="1,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn}" Height="38"
                        Visibility="{x:Bind ViewModel.IsHomePage, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        ToolTipService.ToolTip="Atualizar telas e áudio">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource Btn}" Height="38"
                        Visibility="{x:Bind ViewModel.IsHomePage, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        Command="{x:Bind ViewModel.OpenSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Ajustes"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <views:HomeView Visibility="{x:Bind ViewModel.IsHomePage, Mode=OneWay}"/>
            <views:SettingsView Visibility="{x:Bind ViewModel.IsSettingsPage, Mode=OneWay}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="4,14,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource IconText}" Text="{x:Bind ViewModel.StatusGlyph, Mode=OneWay}" FontSize="14"
                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>

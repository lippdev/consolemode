<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ConsoleMode.ConfirmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Console Mode">

    <Grid x:Name="Root" Padding="32,28" RowSpacing="12" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>
            <TextBlock Text="{x:Bind Texts.ConfirmTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind Texts.ConfirmDescription, Mode=OneWay}"/>
        <ProgressBar x:Name="CountdownBar" Grid.Row="2" Margin="0,8,0,0" Minimum="0"/>
        <TextBlock x:Name="CountdownText" Grid.Row="3" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Click="OnRevert" Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Controller hint: B on Xbox, Circle on PlayStation. -->
                    <FontIcon x:Name="BackXboxGlyph" Glyph="&#xF094;" FontSize="16" Visibility="Collapsed"/>
                    <TextBlock x:Name="BackPsGlyph" Text="○" FontSize="16" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock Text="{x:Bind Texts.Revert, Mode=OneWay}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="KeepButton" Style="{StaticResource AccentButtonStyle}" Click="OnKeep" Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="KeepXboxGlyph" Glyph="&#xF093;" FontSize="16" Visibility="Collapsed"/>
                    <TextBlock x:Name="KeepPsGlyph" Text="✕" FontSize="16" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock Text="{x:Bind Texts.Continue, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
